# Copy to .env for local development. .env is git-ignored and must never contain
# real credentials; deployed environments inject configuration through the task
# definition and AWS Secrets Manager rather than through a file.

# Application
TTB_ENVIRONMENT=local
# The level of the application's own logger, which writes one JSON line per
# record to stderr (backend/app/logging_config.py). DEBUG, INFO, WARNING or
# ERROR; an unrecognised value falls back to INFO and says so. Read by nothing
# until v1.3.0 (code review finding 9).
TTB_LOG_LEVEL=INFO

# There is no setting that opens an outbound connection. The vision-model
# fallback docs/adr/0003-local-ocr-default-bedrock-optional.md describes was
# designed and not built; its three settings were removed in v1.2.1.

# Upload guards. Size is checked before the request body is read and the MIME
# type before the image is decoded (NFR-7).
TTB_MAX_UPLOAD_BYTES=10485760
TTB_MAX_BATCH_FILES=300

# How many photographs of one label POST /api/verify accepts. Three because a
# label wraps a round bottle and no single photograph shows all of it flat:
# front, back, and the seam between them (ADR 0007, assumption A-16). Each
# photograph is still checked individually against TTB_MAX_UPLOAD_BYTES, and
# the request envelope is bounded at one more than this many times that: the
# extra file is the optional COLA document below. The batch path stays at one
# photograph per row.
TTB_MAX_LABEL_PHOTOS=3

# How many pages of an uploaded COLA document are read (FR-11, ADR 0008). The
# application side of TTB F 5100.31 is page 1; the rest of the file is
# instructions and the allowable-revisions table, which carry no applicant
# values. A Public COLA Registry printout runs to one or two. Three is one more
# than either needs, and it bounds what a very long PDF can cost when the OCR
# fallback runs: that path reads each page the way it reads a label photograph,
# so this is a latency limit as much as a parsing one.
TTB_MAX_DOCUMENT_PAGES=3

# The label artwork embedded in a COLA document
# (docs/adr/0010-embedded-label-artwork.md). An applicant affixes the label
# artwork to the application, so a filed PDF carries pictures of the labels
# alongside the typed items, and on the author's own filing the alcohol content
# and the net contents were in those pictures rather than in the text layer.
#
# The floor is an area, and it is the signature discriminator. A filed form
# carries the applicant's handwritten signature as an embedded picture; on the
# author's own filing it is 687 by 195, which is 133,965 pixels, and this floor
# excludes it. The smallest label panel on the second filing the author
# measured, a 187 by 1697 side band, is 317,339 pixels, and this floor admits
# it. Until v1.5.0 two shape rules sat beside it, TTB_MIN_ARTWORK_EDGE_PX and
# TTB_MAX_ARTWORK_ASPECT_RATIO; they rejected five of that filing's six label
# pictures and are gone (ADR 0010 as amended, #121). Setting either now has no
# effect.
#
# A judgement about what a filing looks like, made against two filings rather
# than one; see OQ-24.
TTB_MIN_ARTWORK_PIXELS=250000

# The ceiling on how many surviving images are read on one document. Panels
# are read largest first and reading stops as soon as the panels read so far
# carry all five values, so a one-sheet filing is one read whatever this says
# and a filing with its values spread over five panels is five. Only a filing
# missing a value reads this many. Eight is twice the most any measured filing
# carries above the floor; the response lists each panel and whether it was
# read, not needed, or past this ceiling.
TTB_MAX_ARTWORK_IMAGES=8

# Batch execution (docs/adr/0006-batch-execution-model.md). Both default to 0,
# which means "derive it" rather than "unlimited".
#
# TTB_BATCH_WORKERS is how many images are read at once. Derived from the cores
# this process may use, because OCR is CPU bound and runs in-process.
#
# TTB_MAX_BATCH_BYTES is the largest batch request body accepted, checked from
# Content-Length before the body is read. Derived as
# 2 * TTB_MAX_BATCH_FILES * TTB_MAX_UPLOAD_BYTES, which at the defaults is about
# 6 GiB. The factor of two is docs/adr/0009-batch-cola-documents.md: a batch
# carries one label image and one COLA document per label, and each of the two
# is an upload bounded by TTB_MAX_UPLOAD_BYTES. Read that arithmetic before
# sizing a deployment: the whole envelope is parsed into memory before the route
# runs. Setting a real ceiling here is the lever for bounding batch memory, and
# the deployed task does exactly that rather than taking the derivation. See
# docs/09_DEPLOYMENT.md section 4.4 and OQ-13 item 6.
TTB_BATCH_WORKERS=0
TTB_MAX_BATCH_BYTES=0

# Accepted image MIME types, as a JSON array. Anything else is rejected before
# decoding, with the accepted set named in the message (FR-9, A-3).
TTB_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","image/tiff"]

# The long edge, in pixels, that an uploaded image is scaled to before OCR runs.
# Larger reads small type better and costs latency; see the budget in
# docs/07_TEST_STRATEGY.md section 4.
TTB_OCR_LONG_EDGE_PX=1600

# Turn a sideways photograph upright before reading it, using Tesseract's
# orientation and script detection. On by default: the first real photograph
# submitted to the deployed prototype was taken sideways and none of the five
# fields were found. It costs roughly one extra OCR pass per image, which is
# paid per row on the batch path. Set to false to skip it.
TTB_CORRECT_ORIENTATION=true

# How many single-character edits between the government warning as printed and
# 27 CFR 16.21 are reported as needing human review rather than as a mismatch
# (FR-5, docs/adr/0012-warning-near-miss.md).
#
# **This is not a fuzzy tolerance.** The comparison that decides a match is
# unchanged and still requires identical text after whitespace normalization; a
# near miss is one of the two failing outcomes, with the exact character-level
# difference shown. The author's own COLA artwork OCRs the statement with one
# character wrong, and reporting that as a flat mismatch tells an agent their
# label is defective when the truth is that the scan is imperfect. Raising this
# much above 2 starts to admit substituted short words, which is where the
# wording of the sentence changes rather than its rendering.
TTB_WARNING_NEAR_MISS_EDITS=2

# Matching thresholds (see docs/adr/0004-fuzzy-matching-with-review-band.md)
TTB_MATCH_THRESHOLD=95
TTB_REVIEW_THRESHOLD=80

# Allowed difference between the label ABV and the application ABV, in
# percentage points. Defaults to 0.0: the two declared values must be identical.
# The tolerances in 27 CFR 5.65, 4.36, and 7.65 govern actual against labeled
# alcohol content, not two values the applicant declared. See assumption A-12 in
# docs/ASSUMPTIONS.md and docs/cloud_choice_and_abv_assumption.md section 2.
TTB_ABV_TOLERANCE=0.0

# Tesseract's OpenMP thread count. Not a TTB_ variable: it is read by the
# Tesseract binary itself, and backend/app/ocr.py sets it to 1 if it is unset.
# Leave it at 1. Tesseract's OpenMP runtime deadlocks when the binary is invoked
# from a thread other than the process main thread, which is exactly what the
# batch worker pool does, and one thread per invocation is the right shape
# anyway because the pool already parallelizes across images.
OMP_THREAD_LIMIT=1
