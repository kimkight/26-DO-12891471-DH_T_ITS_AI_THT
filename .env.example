# Copy to .env for local development. .env is git-ignored and must never contain
# real credentials; deployed environments inject configuration through the task
# definition and AWS Secrets Manager rather than through a file.

# Application
TTB_ENVIRONMENT=local
TTB_LOG_LEVEL=INFO

# Optional vision-model fallback for text extraction. Off by default; the
# default path runs OCR locally and makes no outbound network calls.
# See docs/adr/0003-local-ocr-default-bedrock-optional.md.
TTB_ENABLE_BEDROCK_FALLBACK=false
TTB_BEDROCK_REGION=us-east-1
TTB_BEDROCK_MODEL_ID=

# Upload guards. Size is checked before the request body is read and the MIME
# type before the image is decoded (NFR-7).
TTB_MAX_UPLOAD_BYTES=10485760
TTB_MAX_BATCH_FILES=300

# Accepted image MIME types, as a JSON array. Anything else is rejected before
# decoding, with the accepted set named in the message (FR-9, A-3).
TTB_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","image/tiff"]

# The long edge, in pixels, that an uploaded image is scaled to before OCR runs.
# Larger reads small type better and costs latency; see the budget in
# docs/07_TEST_STRATEGY.md section 4.
TTB_OCR_LONG_EDGE_PX=1600

# Matching thresholds (see docs/adr/0004-fuzzy-matching-with-review-band.md)
TTB_MATCH_THRESHOLD=95
TTB_REVIEW_THRESHOLD=80

# Allowed difference between the label ABV and the application ABV, in
# percentage points. Defaults to 0.0: the two declared values must be identical.
# The tolerances in 27 CFR 5.65, 4.36, and 7.65 govern actual against labeled
# alcohol content, not two values the applicant declared. See assumption A-12 in
# docs/ASSUMPTIONS.md and docs/cloud_choice_and_abv_assumption.md section 2.
TTB_ABV_TOLERANCE=0.0
