# Copy to .env for local development. .env is git-ignored and must never contain
# real credentials; deployed environments inject configuration through the task
# definition and AWS Secrets Manager rather than through a file.

# Application
TTB_ENVIRONMENT=local
TTB_LOG_LEVEL=INFO

# Optional vision-model fallback for text extraction. Off by default; the
# default path runs OCR locally and makes no outbound network calls.
# See docs/adr/0003-local-ocr-default-bedrock-optional.md.
TTB_ENABLE_BEDROCK_FALLBACK=false
TTB_BEDROCK_REGION=us-east-1
TTB_BEDROCK_MODEL_ID=

# Upload guards
TTB_MAX_UPLOAD_BYTES=10485760
TTB_MAX_BATCH_FILES=300

# Matching thresholds (see docs/adr/0004-fuzzy-matching-with-review-band.md)
TTB_MATCH_THRESHOLD=95
TTB_REVIEW_THRESHOLD=80
